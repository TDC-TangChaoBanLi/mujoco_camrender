<mujoco model="multi_camera_scene">
  <compiler angle="degree"/>

  <visual>
    <map fogstart="3" fogend="5" force="0.1" znear="0.001"/>
    <quality shadowsize="2048"/>
  </visual>

  <option timestep="0.005"/>

  <!-- ========== Assets ========== -->
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.0 0.0 0.0" width="512" height="512"/>
    <texture name="tex_floor" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.15 0.2"/>
    <material name="mat_floor" texture="tex_floor" texrepeat="5 5" reflectance="0.1"/>
    <material name="mat_red"   rgba="0.8 0.2 0.2 1.0" specular="0.3" shininess="0.4"/>
    <material name="mat_green" rgba="0.2 0.8 0.2 1.0" specular="0.3" shininess="0.4"/>
    <material name="mat_blue"  rgba="0.2 0.2 0.8 1.0" specular="0.3" shininess="0.4"/>
    <material name="mat_yellow" rgba="0.9 0.9 0.1 1.0" specular="0.5" shininess="0.6"/>
  </asset>

  <!-- ========== World body ========== -->
  <worldbody>
    <!-- 光照 -->
    <light name="light_sun" directional="true" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"
           pos="3 -3 5" dir="-0.4 0.4 -0.5" castshadow="true"/>

    <!-- 地板 -->
    <geom name="floor" type="plane" size="0 0 0.05" material="mat_floor" pos="0 0 0"/>

    <!-- 红色球 -->
    <body name="red_sphere" pos="0 1.5 0.5">
      <joint name="red_sphere_fall" type="free"/>
      <geom name="red_sphere_geom" type="sphere" size="0.2" material="mat_red"/>
    </body>

    <!-- 绿色方块 -->
    <body name="green_box" pos="1.5 0 0.3">
      <joint name="green_box_fall" type="free"/>
      <geom name="green_box_geom" type="box" size="0.15 0.15 0.15" material="mat_green"/>
    </body>

    <!-- 蓝色圆柱 -->
    <body name="blue_cylinder" pos="-1 1 0.3">
      <joint name="blue_cylinder_fall" type="free"/>
      <geom name="blue_cylinder_geom" type="cylinder" size="0.15 0.25" material="mat_blue"/>
    </body>

    <!-- 黄色胶囊台座 -->
    <geom name="pedestal" type="cylinder" size="0.4 0.05" material="mat_yellow" pos="0 0 0.025"/>

    <!-- ========== 相机 1：俯视正交 ========== -->
    <camera name="cam_top" mode="fixed" pos="0 0 4" quat="1 0 0 0"
            fovy="45" resolution="640 480"/>

    <!-- ========== 相机 2：正面透视 ========== -->
    <camera name="cam_front" mode="fixed" pos="0 -4 1" quat="0.707 0.707 0 0"
            fovy="45" resolution="640 480"/>

    <!-- ========== 相机 3：侧面透视 ========== -->
    <camera name="cam_side" mode="fixed" pos="4 0 1.5" quat="0.5 0.5 0.5 0.5"
            fovy="50" resolution="800 600"/>

    <!-- ========== 相机 4：近景跟踪 ========== -->
    <camera name="cam_closeup" mode="targetbody" target="red_sphere"
            pos="0 2 0.5" fovy="60" resolution="640 480"/>
  </worldbody>
</mujoco>